{
  "version": "0.2.0",
  "configurations": [
    {
      // First, because it is the one a bare clone can run.
      "name": "Run Extension (fixture)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/fixture",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: bundle"
    },
    {
      // Needs the sibling study checkout and a Fleet install carrying the `lsp` extra.
      "name": "Run Extension (../test-study)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/../test-study",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: bundle"
    }
  ]
}
