{
  "name": "fleet-vscode",
  "displayName": "Fleet CDISC",
  "description": "Language support for Fleet define.yaml specifications: schema diagnostics, algorithm/codelist completions, and hover docs.",
  "version": "0.1.0",
  "publisher": "fleet-vscode",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/RealSlimMahdi/fleet-vscode"
  },
  "homepage": "https://github.com/RealSlimMahdi/fleet-vscode#readme",
  "bugs": {
    "url": "https://github.com/RealSlimMahdi/fleet-vscode/issues"
  },
  "qna": "https://github.com/RealSlimMahdi/fleet-vscode/issues",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1F2430",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.82.0",
    "node": ">=22.18.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "cdisc",
    "sdtm",
    "adam",
    "define-xml",
    "clinical-trials",
    "fleet",
    "yaml",
    "language-server"
  ],
  "activationEvents": [
    "workspaceContains:**/define.yaml",
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Fleet CDISC",
      "properties": {
        "fleet.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `fleet` executable to run as the language server. Takes precedence over the `FLEET_LSP` environment variable, the workspace `.venv`, and the `uv run fleet` fallback. Leave empty to use that discovery order."
        },
        "fleet.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Fleet language server."
        }
      }
    },
    "commands": [
      {
        "command": "fleet.restartServer",
        "title": "Restart Language Server",
        "category": "Fleet CDISC"
      }
    ]
  },
  "vsce": {
    "dependencies": false
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'test/**/*.test.ts'",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run bundle && npm run compile:integration && vscode-test",
    "fixture": "node scripts/build-fixture.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "package": "vsce package && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-vsix.ts",
    "release:preflight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-fleet-release.ts"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.82.0",
    "@types/yauzl": "^3.4.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "ovsx": "^1.1.1",
    "prettier": "^3.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.15.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  }
}
